{
  "identity": {
    "name": "0middle",
    "mission": "Empower farmers and consumers with a transparent, infrastructure-only marketplace.",
    "tone": "Trustworthy, Transparent, Earthy, Authentic, Simple",
    "visual_mood": "Organic, Clean, Farm-to-Table, Minimalist but warm",
    "theme_mode": "light"
  },
  "typography": {
    "fonts": {
      "heading": "Playfair Display, serif",
      "body": "Manrope, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "weights": {
      "heading": "font-semibold or font-bold",
      "body": "font-normal or font-medium"
    },
    "usage": {
      "h1": "text-4xl md:text-5xl font-bold tracking-tight text-primary",
      "h2": "text-3xl md:text-4xl font-semibold tracking-tight text-primary/90",
      "h3": "text-2xl font-medium text-foreground",
      "body": "text-base leading-relaxed text-muted-foreground",
      "caption": "text-sm text-muted-foreground/80"
    }
  },
  "colors": {
    "palette": {
      "background": "#FAF9F6",
      "foreground": "#1A1A1A",
      "primary": "#2F5233",
      "primary_foreground": "#FFFFFF",
      "secondary": "#B5651D",
      "secondary_foreground": "#FFFFFF",
      "muted": "#F0EFEA",
      "muted_foreground": "#6B7280",
      "accent": "#D4A373",
      "accent_foreground": "#1A1A1A",
      "card": "#FFFFFF",
      "card_foreground": "#1A1A1A",
      "border": "#E5E7EB",
      "input": "#E5E7EB",
      "ring": "#2F5233"
    },
    "tailwind_mapping": {
      "--background": "40 14% 97%",
      "--foreground": "0 0% 10%",
      "--primary": "127 27% 25%",
      "--primary-foreground": "0 0% 100%",
      "--secondary": "28 72% 41%",
      "--secondary-foreground": "0 0% 100%",
      "--muted": "40 10% 93%",
      "--muted-foreground": "220 9% 46%",
      "--accent": "30 52% 64%",
      "--accent-foreground": "0 0% 10%",
      "--card": "0 0% 100%",
      "--card-foreground": "0 0% 10%",
      "--border": "220 13% 91%",
      "--input": "220 13% 91%",
      "--ring": "127 27% 25%"
    }
  },
  "spacing": {
    "container_padding": "p-4 md:p-8 lg:p-12",
    "section_gap": "gap-8 md:gap-12",
    "element_gap": "gap-4",
    "border_radius": "rounded-xl md:rounded-2xl"
  },
  "components": {
    "buttons": {
      "default": "rounded-full font-medium transition-all hover:shadow-md active:scale-95",
      "primary": "bg-primary text-primary-foreground hover:bg-primary/90",
      "secondary": "bg-secondary text-secondary-foreground hover:bg-secondary/90",
      "outline": "border-2 border-primary text-primary hover:bg-primary/5"
    },
    "cards": {
      "style": "bg-card text-card-foreground rounded-xl border border-border/50 shadow-sm hover:shadow-md transition-shadow duration-300",
      "padding": "p-6"
    },
    "inputs": {
      "style": "rounded-lg border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
    }
  },
