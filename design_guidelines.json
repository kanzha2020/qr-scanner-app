  "icons": {
    "primary_library": "lucide-react",
    "secondary_library": "@phosphor-icons/react",
    "style": "Stroke width 1.5px or 2px, rounded caps"
  },
  "motion": {
    "transitions": "transition-all duration-300 ease-in-out",
    "hover_effects": "hover:-translate-y-1 hover:shadow-lg",
    "page_transition": "initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -20 }}"
  },
  "universal_guidelines": [
    "Do not use gradients for backgrounds; use solid earth tones or subtle textures.",
    "Ensure high contrast for text readability (WCAG AA).",
    "Use generous padding (p-6, p-8) to create breathing room.",
    "Avoid 'tech' blues and purples; stick to the earth palette.",
    "Mobile-first design is critical.",
    "All interactive elements must have data-testid attributes."
  ],
  "instructions_to_main_agent": [
    "1. Update /app/frontend/src/index.css with the new color palette variables.",
    "2. Install necessary fonts (Playfair Display, Manrope) via Google Fonts import in index.css.",
    "3. Create a 'TransparentPricing' component that visualizes the cost breakdown clearly.",
    "4. Build the 'FarmerProfile' and 'ProductListing' components using the provided image URLs.",
    "5. Implement the 'RoleSelection' screen with clear, large touch targets.",
    "6. Ensure the 'OrderTracking' flow uses a simple vertical timeline.",
    "7. Use 'sonner' for all toast notifications.",
    "8. Mock all backend calls; no real API integration required."
  ]
}